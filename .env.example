# ─────────────────────────────────────────────────────────────
#  foodbot — environment.  Copy to .env and fill in.
#  NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────

# ── Postgres (same DB as JobBot is fine — tables don't clash) ──
PGHOST=your-db-host
PGPORT=25060
PGUSER=doadmin
PGPASSWORD=your-db-password
PGDATABASE=defaultdb
PGSSLMODE=require

# ── Claude (vision engine for calorie estimates) ──
# Option A: subscription CLI (like JobBot) — leave ANTHROPIC_API_KEY empty,
#           make sure `claude` CLI is authenticated (claude setup-token).
# Option B: direct API — set a real sk-ant- key.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-5
# Monthly non-interactive credit of your plan (for the budget line in reports)
MONTHLY_CREDIT_USD=100

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_ALLOWED_USER_ID=000000000

# ── Garmin Connect (unofficial API; tokens cached after first login) ──
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password
GARMIN_TOKEN_DIR=~/.garminconnect

# ── Targets ──
FOOD_TZ=Europe/Madrid
TARGET_KCAL=1650
PROTEIN_TARGET_G=160
GOAL_WEIGHT=77
GOAL_DATE=2026-10-14

# ── Sunday grocery list: who else to shop for (free text, fed to the model) ──
# GROCERY_NOTES=Закупка на двоих: George + жена. Жена не ест мясо, вместо него индейка. Её порции без дефицита.